# LLM configuration (OpenAI-compatible API).
# The example below targets Groq's OpenAI-compatible endpoint.
# Put your real key in .env (which is git-ignored) — never in this file.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_FALLBACK_MODEL=llama-3.1-8b-instant

# Dataset paths (repo-root-relative; loader.py resolves them against the repo root).
YELP_BUSINESS_PATH=backend/data/raw/yelp_academic_dataset_business.json
YELP_REVIEW_PATH=backend/data/raw/yelp_academic_dataset_review.json
MAX_REVIEW_SAMPLE=100
RANDOM_SEED=42
